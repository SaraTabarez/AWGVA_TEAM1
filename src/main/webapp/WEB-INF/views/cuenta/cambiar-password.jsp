<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cambiar contraseña - AWGVA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"><link href="${ctx}/assets/css/workflow.css" rel="stylesheet"></head><body>
<jsp:include page="/Layout/sidebar.jsp"/><main class="workflow-main"><h1 class="workflow-title">Cambiar contraseña</h1><div class="workflow-subtitle">Protege tu acceso al sistema</div>
<div class="workflow-card" style="max-width:650px"><c:if test="${not empty error}"><p style="color:#991b1b"><c:out value="${error}"/></p></c:if><c:if test="${not empty exito}"><p style="color:#166534"><c:out value="${exito}"/></p></c:if>
<form action="${ctx}/cambiar-contrasena" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><label class="workflow-label">Contraseña actual</label><input class="workflow-input" type="password" name="actual" autocomplete="current-password" required><br><br><label class="workflow-label">Nueva contraseña</label><input class="workflow-input" type="password" name="nueva" autocomplete="new-password" minlength="10" required><small>Al menos 10 caracteres, mayúscula, minúscula, número y símbolo.</small><br><br><label class="workflow-label">Confirmar nueva contraseña</label><input class="workflow-input" type="password" name="confirmar" autocomplete="new-password" minlength="10" required><br><br><button class="workflow-btn orange"><i class="bi bi-key"></i> Actualizar contraseña</button></form></div>
</main></body></html>
