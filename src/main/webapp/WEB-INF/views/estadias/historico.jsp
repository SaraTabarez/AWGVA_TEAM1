<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!doctype html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Histórico Estadías - AWGVA</title><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"><link href="${ctx}/assets/css/workflow.css" rel="stylesheet"></head><body>
<jsp:include page="/Layout/sidebar.jsp"/><main class="workflow-main"><h1 class="workflow-title">Histórico de visitas recibidas</h1><div class="workflow-subtitle">Todas las divisiones y todas las visitas que han entregado documentos</div><form class="workflow-card workflow-filters" action="${ctx}/estadias/historico" method="get"><div><label class="workflow-label">Buscar</label><input class="workflow-input" name="q" value="<c:out value='${param.q}'/>" placeholder="ID, empresa, división o carrera"></div><div></div><div></div><div></div><button class="workflow-btn navy"><i class="bi bi-search"></i> Buscar</button></form>
<div class="workflow-card" style="padding:0;overflow:auto"><table class="workflow-table"><thead><tr><th>ID</th><th>Empresa</th><th>Docente</th><th>División</th><th>Carrera</th><th>Fecha</th><th>Estado</th><th>Detalle</th></tr></thead><tbody><c:forEach var="sol" items="${solicitudes}"><tr><td><c:out value="${sol.idVisita}"/></td><td><c:out value="${sol.empresa}"/></td><td><c:out value="${sol.docente}"/></td><td><c:out value="${sol.division}"/></td><td><c:out value="${sol.carrera}"/></td><td><c:out value="${sol.fechaInicio}"/></td><td><span class="status"><c:out value="${sol.estadoLegible}"/></span></td><td><c:choose><c:when test="${not empty sol.estadoReporte}"><c:set var="docReporte" value="${null}"/><a class="workflow-btn light" style="min-height:32px;padding:5px 14px" href="${ctx}/estadias/documentos?q=${sol.idVisita}"><i class="bi bi-folder2-open"></i></a></c:when><c:otherwise><a class="workflow-btn light" style="min-height:32px;padding:5px 14px" href="${ctx}/estadias/documentos?q=${sol.idVisita}"><i class="bi bi-folder2-open"></i></a></c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty solicitudes}"><tr><td class="empty-row" colspan="8">Aún no se han recibido visitas.</td></tr></c:if></tbody></table></div></main></body></html>
